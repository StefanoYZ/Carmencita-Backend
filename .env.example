APP_NAME=Carmencita Express Backend
API_PREFIX=/api/v1
ENVIRONMENT=development
JWT_SECRET_KEY=
REDIS_URL=redis://localhost:6379/0
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=604800
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAME_SITE=lax
REFRESH_COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/carmencita_db
# Only inject these into the one-time deployment job from Secret Manager.
ADMIN_PROVISIONING_TOKEN=
ADMIN_INITIAL_PASSWORD=
